# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" a un repositorio (ya está en .gitignore).

# Cadena de conexión a Neon Postgres
DATABASE_URL=postgresql://usuario:password@host/basededatos?sslmode=require

# Puerto del servidor HTTP
PORT=4000

# Origen(es) permitido(s) para CORS, separados por coma (el/los dominios del frontend)
CORS_ORIGIN=http://localhost:3000

# Secreto para firmar los JWT de sesión (usa una cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Duración de la cookie de sesión
JWT_EXPIRES_IN=7d

# true en producción (cookies "Secure", requiere HTTPS)
COOKIE_SECURE=false

# Reglas de bloqueo por intentos fallidos (HU-02)
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Expiración de tokens (HU-04 y HU-05)
EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_MINUTES=60

# URL pública del frontend, usada para construir los enlaces de los correos
FRONTEND_URL=http://localhost:3000

# --- Envío de correo (opcional) ---
# Si no configuras SMTP, los correos se imprimen en la consola del backend
# (útil para desarrollo). Completa esto para enviar correos reales.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Quiero Reservar <no-reply@quieroreservar.com>"
